# This fork's serve: Mia TR3 EXL3, Dealign o_proj transplant, 524288-token latent FP8 context.
# Not config/prod.env.example (neko-legends, q4mse, 4-request 1M pool, RoCE, port 8000).
# Docs: docs/MIA-512K.md. Measured speeds: README.md and results/mia-512k/.
#
# Copy to config/mia-512k.env (gitignored), fill the placeholders, then:
#   CONFIG=config/mia-512k.env scripts/serve.sh build
#   CONFIG=config/mia-512k.env scripts/serve.sh preflight
#   CONFIG=config/mia-512k.env scripts/serve.sh start
# serve.sh reads config/prod.env if CONFIG is unset. Set CONFIG.

# --- nodes / link ---------------------------------------------------------------
# ssh target of the worker Spark (rank 1). Passwordless ssh, and docker without sudo, as in AGENTS.md.
WORKER_SSH="<worker-ssh>"
# Rank 0's IPv4 on the CX7 link. Not the management address. NFS for the worker cache, if you use it,
# must export from this address too; the management network is the wrong NIC.
HEAD_IP="<head-ip>"
# Crossed cable: the port that faces the other Spark is not the same name on both nodes.
# `ibdev2netdev` prints "<RDMA device> port 1 ==> <netdev> (Up)" for the cabled port.
# Same-named HCAs are not on one subnet. Do not list every HCA; NCCL will not finish init.
# The names below are the pair that came up on the machine this profile was measured on.
NCCL_SOCKET_IFNAME=enp1s0f0np0
NCCL_IB_HCA=rocep1s0f0
HEAD_NCCL_SOCKET_IFNAME=enp1s0f0np0
HEAD_NCCL_IB_HCA=rocep1s0f0
WORKER_NCCL_SOCKET_IFNAME=enp1s0f1np1
WORKER_NCCL_IB_HCA=rocep1s0f1
MASTER_PORT=29551

# --- weights (each node's HF cache is mounted at /root/.cache/huggingface) -------
# Absolute host paths, e.g. /home/<you>/.cache/huggingface
# The worker path must be readable by the worker user. A Docker volume that user cannot read fails preflight.
HEAD_HF="<head HF cache>"
WORKER_HF="<worker HF cache>"
# patches/0140. First start writes these (~89 GB for this checkpoint's rank-0 folder). Not in git.
HEAD_PREPARED=/home/<you>/glm53-tf/prepared
WORKER_PREPARED=/home/<you>/glm53-tf/prepared
HEAD_SESSIONS=/home/<you>/glm53-tf/sessions
WORKER_SESSIONS=/home/<you>/glm53-tf/sessions
# Mia mirror of brandonmusic/GLM-5.3-Flash-tr3-4bpw. ShapleyMcg License 1.0. Not pre-abliterated.
# Path inside the container; the snapshot must exist in both nodes' caches.
MODEL_PATH=/root/.cache/huggingface/hub/models--Mia-AiLab--GLM-5.3-Flash-EXL3-TR3-4bpw/snapshots/25a44fdbf16862a46b7cc9921142c6c81350af2f
# DFlash2: CC BY-NC-ND 4.0, non-commercial only, not bundled. This pin is dc77ff1c, not prod.env.example's 7d74cdd.
# Empty DRAFTER= uses MTP drafts only.
DRAFTER=/root/.cache/huggingface/hub/models--incoai--GLM-5.3-Flash-DFlash2/snapshots/dc77ff1c99eeb2df044ee3d4f0094eb033fee410

# --- serving --------------------------------------------------------------------
IMAGE=glm53-tensorfold:dev
SERVED_NAME=GLM-5.3-Flash-EXL3
# No authentication. 0.0.0.0 is what this boot used; 127.0.0.1 keeps it on the head.
HOST=0.0.0.0
PORT=8888
# Prompt + reply tokens reserved per request. Latent FP8 is required at this length.
# Per-head KV (~390 KB/token/rank) does not fit at 524288. Do not set FORCE_CONTEXT=1.
CONTEXT=524288
MAX_TOKENS=32768

# --- ops ------------------------------------------------------------------------
CANARY=off
PREFLIGHT=strict
# MemFree floor checked before launch, both nodes. Not a promise about MemFree after the model is resident.
MEM_GATE_GIB=8
MEM_GATE_TIMEOUT=60
MEM_GATE_DROP_CACHES=0

# --- engine ---------------------------------------------------------------------
# q4mse quantizes every BF16 non-expert except the transplanted o_proj (patches/0430).
# lm_head is plain min/max 4-bit, not the clip search (patches/0440).
# Layers 15-44 stay BF16. A prepared folder built with bf16, or with a q4mse head, is not reused.
GLM53_TF_NONEXPERT=q4mse
# Requested concurrency. At 524288 latent-fp8 slots the default 4 GB reserve fits one sequence (3.96 GB).
# The 2026-09-29 boot served 1. Raising this does not by itself add a second sequence.
GLM53_TF_BATCH=2
GLM53_TF_LATENT_KV=1
GLM53_TF_KV_DTYPE=fp8
GLM53_TF_COMM_BACKEND=nccl
GLM53_TF_AUTO_FDRAFTS=7
GLM53_TF_DEPTH=threshold
GLM53_TF_LONGCTX_GRAPHS=1
NO_DRAFTS=0

# --- abliteration (patches/0420) ------------------------------------------------
# Runtime copy only. Layers 15-44. Layer 45 is in the donor and is the MTP block; it is not applied.
# Donor: BF16 model.language_model.layers.{15-45}.self_attn.o_proj.weight from the Dealign NVFP4 checkpoint.
# Same host path on both nodes. Not in git.
GLM53_TF_ABLIT=1
GLM53_TF_ABLIT_LAYERS=15-44
GLM53_TF_ABLIT_DONOR=/ablit/donor.safetensors
ABLIT_DONOR_HOST="<donor safetensors on both nodes>"
